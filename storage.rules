rules_version = '2';

// Regras do Firebase Storage — Azuos Paralegal
//
// [02/08/2026] ARQUIVO PREVENTIVO — o Storage NAO esta em uso hoje.
// Conferido: index.html:110 inicializa firebase.storage(), mas nao ha um unico
// upload, download ou ref no codigo. Os anexos moram no FIRESTORE, em azuos/anx_*
// (ver public/firestore.js), ja cobertos por match /azuos/{doc=**}. E a API
// firebasestorage.googleapis.com nem esta habilitada no projeto.
//
// Ainda assim, este arquivo estava com `allow read, write: if request.auth != null`,
// que no dia em que o Storage fosse ativado deixaria QUALQUER conta autenticada —
// inclusive uma criada por um estranho pela API publica — ler e apagar todos os
// anexos. Endurecido agora, com a MESMA lista branca do firestore.rules, para a
// porta ja nascer fechada.
//
// PARA ATIVAR: habilite a API no Console, devolva a secao "storage" ao
// firebase.json e volte a incluir 'storage' no deploy-firestore-rules.yml.
// Incluir antes disso quebra o deploy INTEIRO e impede ate as regras do Firestore
// de serem publicadas — foi o que aconteceu na primeira tentativa.
//
// Ao mexer aqui, mexa tambem em firestore.rules — as duas listas precisam
// concordar. Ver COMO-PUBLICAR-REGRAS-FIREBASE.md.

service firebase.storage {
  match /b/{bucket}/o {

    function autorizado() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'contato@azuoscontabil.com.br',
          'thierrymforte@gmail.com',
          'comercial@azuoscontabil.com.br',
          'camila@azuoscontabil.com.br',
          'ketrin@azuoscontabil.com.br',
          'luannaferreirabatista20@gmail.com',
          'diogenes@azuoscontabil.com.br',
          'leylabraz1994@outlook.com',
          'paralegal10@gmail.com',
          'integracao.grupoazuos@gmail.com',
          'grupob2bbrasil@icloud.com',
          'paralalegal6@gmail.com',            // Yara
          'advgabryelisaac@gmail.com',         // Gabryel
          'paralalegal2@gmail.com',            // Humberto
          'paralalegal2@gmail.com.br'          // Humberto — segunda conta, em uso
        ];
    }

    match /anexos/{allPaths=**} {
      allow read, write: if autorizado();
    }

    // Qualquer outro caminho fica bloqueado por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
