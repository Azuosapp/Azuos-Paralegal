rules_version = '2';

// ============================================================
//  Regras de segurança do Firestore — Azuos Paralegal
//  Objetivo: SOMENTE os e-mails autorizados abaixo podem ler/escrever
//  no banco. Qualquer outra conta (mesmo logada) é bloqueada.
//
//  IMPORTANTE: para um usuário NOVO da equipe conseguir acessar, o
//  e-mail dele precisa ser adicionado na lista `autorizado()` e as
//  regras precisam ser PUBLICADAS de novo no Console do Firebase.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Lista branca de e-mails autorizados (em minúsculas).
    //
    // ATENÇÃO — esta lista é a causa mais comum de "não consigo salvar" / "dá erro
    // ao abrir chamado". Quem não estiver aqui LOGA no sistema normalmente, mas
    // TODA escrita no banco é recusada (permission-denied). Como o app guarda o
    // dado no navegador antes de sincronizar, a pessoa acha que salvou — e nada
    // chega para o resto da equipe.
    //
    // Ao cadastrar alguém novo, ou quando alguém trocar de e-mail de acesso,
    // ACRESCENTE aqui e publique de novo (Console do Firebase → Firestore →
    // Rules). O deploy do site NÃO publica regras — ver COMO-PUBLICAR-REGRAS-FIREBASE.md.
    // Conferido em 29/07/2026 contra as contas REAIS do Firebase Authentication
    // (workflow "Testar Acesso Real"). Nao confie na intuicao sobre qual e o
    // e-mail de alguem: varias pessoas entram com endereco pessoal, e havia
    // endereco autorizado aqui que nao existia como conta nenhuma.
    function autorizado() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          // --- contas com login confirmado ---
          'contato@azuoscontabil.com.br',      // AZUOS Admin
          'thierrymforte@gmail.com',
          'comercial@azuoscontabil.com.br',
          'camila@azuoscontabil.com.br',
          'ketrin@azuoscontabil.com.br',
          'luanna@azuoscontabil.com.br',
          'diogenes@azuoscontabil.com.br',
          'leylabraz1994@outlook.com',         // Leyla — e ESTE o login dela
          'paralegal10@gmail.com',
          'integracao.grupoazuos@gmail.com',
          'grupob2bbrasil@icloud.com'

          // NAO adicione e-mail "reservado", de conta que ainda nao existe.
          // Uma auditoria de arquitetura em 29/07/2026 mostrou que isso era uma
          // porta aberta: o e-mail autorizado aqui, somado ao auto-cadastro da
          // tela de login, permitia que QUALQUER pessoa criasse a conta com
          // aquele endereco e ganhasse leitura e escrita totais no banco.
          // A ordem correta e: criar o acesso (Usuarios -> Criar acesso), e SO
          // ENTAO incluir o e-mail aqui.
        ];
    }

    // Coleções usadas pelo app — somente autorizados.
    match /azuos/{doc=**}       { allow read, write: if autorizado(); }
    match /alvaras/{doc=**}     { allow read, write: if autorizado(); }
    match /backups/{doc=**}     { allow read, write: if autorizado(); }
    match /por_usuario/{doc=**} { allow read, write: if autorizado(); }

    // Tudo o que não foi listado acima fica bloqueado por padrão.
    match /{document=**} { allow read, write: if false; }
  }
}
